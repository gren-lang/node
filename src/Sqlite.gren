module Sqlite exposing (..)


import Array.Builder
import FileSystem
import FileSystem.Path exposing (Path)
import Json.Decode as Decode
import Sqlite.Decode
import Sqlite.Decode.Row
import Sqlite.Encode
import Sqlite.Encode.Row
import Task exposing (Task)
import Gren.Kernel.Sqlite


-- TODO: Implement function, aggregate, backup, db encoder, db decoder
-- From: https://nodejs.org/docs/latest-v22.x/api/sqlite.html


type Database
    -- NOTE: implemented in kernel code
    = Database


type Location
    = Memory
    | File Path


{-| When opening the database, you can define a set of restrictions that apply for all
queries and statements executed.

    * `readOnly` - If true, the database is opened in read-only mode. All attempted modifications will fail.
    * `allowExtension` - If true, the loadExtension SQL function and the loadExtension() method are enabled.
    * `enableForeignKeyConstraints` - If true, foreign key constraints are enabled. This is recommended but can be disabled for compatibility with legacy database schemas. The enforcement of foreign key constraints can be enabled and disabled after opening the database using PRAGMA foreign_keys.
    * `timeout` - The busy timeout in milliseconds. This is the maximum amount of time that SQLite will wait for a database lock to be released before returning an error. 0 or negative number means no timeout.
-}
type alias Options =
    { readOnly : Bool
    , enableForeignKeyConstraints : Bool
    , allowExtension : Bool
    , timeout : Int
    }


defaultOptions : Options
defaultOptions =
    { readOnly = False
    , enableForeignKeyConstraints = True
    , allowExtension = False
    , timeout = 5000
    }


open : FileSystem.Permission -> Options -> Location -> Task Error Database
open _ opts location =
    when location is
        File path ->
            Gren.Kernel.Sqlite.open opts path

        Memory ->
            Gren.Kernel.Sqlite.openInMemory opts


close : Database -> Task Error {}
close =
    Gren.Kernel.Sqlite.close



-- Backup


type Backup
    = Backup
        { destination : Path
        , pages : Int
        , db : Database
        }



backup : FileSystem.Permission -> Path -> Database -> Backup
backup _ path db =
    Backup
        { destination = path
        , pages = 100
        , db = db
        }


withBackupPageRate : Int -> Backup -> Backup
withBackupPageRate pages (Backup record) =
    Backup { record | pages = pages }


runBackup : Backup -> Task Error {}
runBackup (Backup { destination, pages, db }) =
    Gren.Kernel.Sqlite.backup destination pages db



-- Query


type alias Query value =
    { query : String
    , parameters : Array Sqlite.Encode.Row.Value
    , rowDecoder : Sqlite.Decode.Row.Decoder value
    }


getOne : Database -> Query value -> Task Error value
getOne db query =
    Gren.Kernel.Sqlite.getMaybeOne query db
        |> Task.andThen
            (\results ->
                when results is
                    Nothing ->
                        Task.fail NoResultsError

                    Just value ->
                        Task.succeed value
            )


getMaybeOne : Database -> Query value -> Task Error (Maybe value)
getMaybeOne db query =
    Gren.Kernel.Sqlite.getMaybeOne query db
        

getAll : Database -> Query value -> Task Error (Array value)
getAll db query =
    foldl Array.Builder.pushLast (Array.Builder.empty 0) db query
        |> Task.map Array.Builder.toArray


foldl : (a -> b -> b) -> b -> Database -> Query a -> Task Error b
foldl func acc db query =
    Gren.Kernel.Sqlite.foldl query db func acc


-- EXECUTIONS


type alias Statement =
    { statement : String
    , parameters : Array Sqlite.Encode.Row.Value
    }


{-| A summary of how an execution changed the database.

    * `changes` - how many rows were inserted/updated/removed
    * `lastInsertRowId` - the ID of the last row inserted. Might be negative if no row was inserted
-}
type alias ExecutionSummary =
    { changes : Int
    , lastInsertRowid : Int
    }


execute : Database -> Statement -> Task Error ExecutionSummary
execute db { statement, parameters } =
    executeForEach
        db
        { statement = statement
        , parameters = (\_ -> parameters)
        }
        [{}]


executeAll : Database -> Array Statement -> Task Error (Array ExecutionSummary)
executeAll db statements =
    statements
        |> Array.map (execute db)
        |> Task.sequence


executeForEach :
    Database
    -> { statement : String
       , parameters : value -> Array Sqlite.Encode.Row.Value
       }
    -> Array value
    -> Task Error ExecutionSummary
executeForEach db stmt vals =
    Gren.Kernel.Sqlite.executeMany stmt vals db


executeScript : Database -> String -> Task Error Database
executeScript db script =
    Gren.Kernel.Sqlite.executeScript script db


-- TRANSACTIONS


inTransaction : Database -> Task Error a -> Task Error a
inTransaction db f =
    executeScript db "BEGIN TRANSACTION"
        |> Task.andThen
            (\_ ->
                f
                    |> Task.andThen
                        (\v ->
                            executeScript db "COMMIT"
                                |> Task.map (\_ -> v)
                        )
                    |> Task.onError
                        (\err ->
                            executeScript db "ROLLBACK"
                                |> Task.andThen (\_ -> Task.fail err)
                        )
            )


-- ERRORS


-- TODO: How detailed should we be with errors?
type Error
    = GenericError String
    | NoResultsError
    | MultipleResultsError Int
    | ForeignKeyError String
    | UniqueConstraintError String
    | DecodingError Decode.Error


errorToString : Error -> String
errorToString error =
    when error is
        GenericError s ->
            s

        NoResultsError ->
            "Expected a result but got none."

        MultipleResultsError n ->
            "Expected one result but got " ++ String.fromInt n

        ForeignKeyError s ->
            "Foreign key error: " ++ s

        UniqueConstraintError s ->
            "Unique constraint error: " ++ s

        DecodingError e ->
            "Error decoding results: " ++ Decode.errorToString e
