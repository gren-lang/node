module Sqlite.Decode exposing
    ( Decoder

    -- Field decoders
    , bool
    , float
    , int
    , string
    , json
    , time
    , maybe

    -- Composing
    , succeed
    , fail

    , unwrap
    )

{-| Decode SQL results into Gren values.

Decoders can be chained to decode all fields in the result set,
with the string parameter matching the name of the field in the query.

For example:

    Sqlite.getOne
        { query = "SELECT id, name FROM users WHERE id = :id"
        , parameters = [ Sqlite.Encode.int "id" 1 ]
        , rowDecoder =
            Sqlite.Decode.int "id" <| \id ->
            Sqlite.Decode.string "name" <| \name ->
                Sqlite.Decode.succeed
                    { id = id
                    , name = name
                    }
        }

@docs Decoder

## Field Decoders

@docs string, int, float, bool, json, time, maybe

## Composing Decoders

@docs succeed, fail

## Helpers

@docs toJson

-}

import Json.Decode
import Math
import Time


{-| A decoder for a database row.
-}
type Decoder a
    = Decoder (Json.Decode.Decoder a)


{-| Decode a string field.
-}
string :Decoder String
string =
    Json.Decode.string |> Decoder


{-| Decode an integer field.
-}
int : Decoder Int
int =
    Json.Decode.int |> Decoder


{-| Decode a float field.
-}
float : Decoder Float
float =
    Json.Decode.float |> Decoder


{-| Decode a boolean field.

Booleans in sqlite are stored as integers with 1 and 0 as True and False.
See <https://www.sqlite.org/datatype3.html#boolean_datatype>
-}
bool : Decoder Bool
bool =
    Json.Decode.int
        |> Json.Decode.andThen
            (\i ->
                when i is
                    0 ->
                        Json.Decode.succeed False

                    1 ->
                        Json.Decode.succeed True

                    n ->
                        Json.Decode.fail <|
                            "Expected 0 or 1 in boolean field, got " ++
                            String.fromInt n
            )
        |> Decoder


{-| Decode a JSON field.

The first parameter is a `Json.Decode.Decoder` for the value stored in the column.
Use `json()` in your SELECT to ensure you get text regardless of how the JSON was stored:

    Sqlite.getOne
        { query = "SELECT json(tags) as tags FROM items WHERE id = 1"
        , parameters = []
        , rowDecoder =
            Sqlite.Decode.json (Json.Decode.array Json.Decode.string) "tags" <| \tags ->
                Sqlite.Decode.succeed { tags = tags }
        }

See <https://www.sqlite.org/json1.html>
-}
json : Json.Decode.Decoder a -> Decoder a
json jsonDecoder =
    Json.Decode.string
        |> Json.Decode.andThen
            (\str ->
                when Json.Decode.decodeString jsonDecoder str is
                    Ok val ->
                        Json.Decode.succeed val

                    Err err ->
                        Json.Decode.fail (Json.Decode.errorToString err)
            )
        |> Decoder


{-| Decode a Time.Posix value.

Expects the db field to hold the number of seconds since unix epoch, which is
how both [Sqlite.Encode.time](Sqlite.Encode#time) and
[Sqlite.Encode.timeWithMillis](Sqlite.Encode#timeWithMillis) store it, and
which aligns with SQLite's `unixepoch` function.
See <https://sqlite.org/lang_datefunc.html>
-}
time : Decoder Time.Posix
time =
    Decoder <|
        Json.Decode.map
            (\seconds -> Time.millisToPosix (Math.round (seconds * 1000.0)))
            Json.Decode.float


{-| Decode a nullable field in the database.

The first parameter is the field decoder function for the type if the value is not null.
For example, to decode a nullable TEXT field:

    Decode.field (Decode.maybe Decode.string) "nickname" <| \maybeNickname ->
        Sqlite.Decode.succeed maybeNickname
-}
maybe : Decoder a -> Decoder (Maybe a)
maybe decoder =
    Decoder <|
        Json.Decode.oneOf
            [ unwrap decoder |> Json.Decode.map Just
            , Json.Decode.succeed Nothing
            ]


-- COMPOSING


{-| Create a decoder that always succeeds with the given value.

Often used as the final step when chaining field decoders:

    Sqlite.Decode.string "name" <| \name ->
    Sqlite.Decode.int "age" <| \age ->
        Sqlite.Decode.succeed { name = name, age = age }
-}
succeed : a -> Decoder a
succeed val =
    Decoder (Json.Decode.succeed val)


{-| Force a decoder to fail with the given message.
-}
fail : String -> Decoder a
fail reason =
    Decoder (Json.Decode.fail reason)


-- HELPERS


{-| Convert to a Json.Decode.Decoder.

This is used internally to communicate with sqlite in the kernel.
-}
toJson : Decoder a -> Json.Decode.Decoder a
toJson =
    unwrap

unwrap : Decoder a -> Json.Decode.Decoder a
unwrap (Decoder d) =
    d
