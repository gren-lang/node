module Sqlite.Decode.Row exposing ( Decoder, column, succeed, fail )

{-| Decode SQL values by their column name.

This decoder is primarily used to decode results from a SQLite [query](Sqlite#Query).

@docs Decoder, column

@docs succeed, fail

-}

import Json.Decode
import Sqlite.Decode


{-| A decoder for a row.
-}
type Decoder a
    = Decoder (Json.Decode.Decoder a)


{-| Decode a [`Sqlite.Encode.Value`](Sqlite.Encode#Value) for the given column name.
-}
column : String -> Sqlite.Decode.Decoder a -> (a -> Decoder b) -> Decoder b
column columnName decoder cont =
    Json.Decode.field columnName (Sqlite.Decode.unwrap decoder)
        |> Json.Decode.andThen (\val ->
            let
                (Decoder decoder_) =
                    cont val
            in
            decoder_
        )
        |> Decoder


{-| Create a decoder that always succeeds with the given value.

Often used as the final step when chaining field decoders:

    Sqlite.Decode.Row.column "name" Sqlite.Decode.string <| \name ->
    Sqlite.Decode.Row.column "age" Sqlite.Decode.int <| \age ->
        Sqlite.Decode.Row.succeed 
            { name = name
            , age = age 
            }
-}
succeed : a -> Decoder a
succeed val =
    Decoder (Json.Decode.succeed val)


{-| Force a decoder to fail with the given message.
-}
fail : String -> Decoder a
fail reason =
    Decoder (Json.Decode.fail reason)
