module Net.Socket exposing (close, end, readable, socketId, write)

{-| Read from and write to TCP sockets.

These operations are used on the [`Socket`](Net#Socket) values handed out by
[`Net.connect`](Net#connect) and [`Net.onConnection`](Net#onConnection).

## Identifying

@docs socketId

## Reading

@docs readable

## Writing

@docs write, end, close
-}

import Bytes exposing (Bytes)
import Gren.Kernel.Net
import Net exposing (NetError, Socket)
import Stream exposing (Readable)
import Task exposing (Task)



-- IDENTIFYING


{-| Get a comparable identifier for a socket.

Useful for storing sockets in a `Dict Int Socket`.
-}
socketId : Socket -> Int
socketId socket =
    Gren.Kernel.Net.getSocketId socket



-- READING


{-| The stream of incoming data for a socket.

Each read yields the next chunk of received bytes; TCP is a byte stream, so
chunk boundaries follow the socket's data events and are not part of any
application-level framing. Read chunks from it using the [`Stream`](Stream)
module, for example [`Stream.read`](Stream#read) or
[`Stream.readUntilClosed`](Stream#readUntilClosed). The stream closes when
the connection ends, and errors if the connection errors (observed as
`Stream.Cancelled`).

    Net.Socket.readable socket
        |> Stream.read
        |> Task.attempt ReadResult

-}
readable : Socket -> Readable Bytes
readable socket =
    Gren.Kernel.Net.getReadable socket



-- WRITING


{-| Send bytes to the remote peer.

The task resolves once the data has been handed off to the operating system
(node's `socket.write` callback), and fails with a [`NetError`](Net#NetError)
if the write fails.

    Net.Socket.write socket (Bytes.fromString "Hello!")
        |> Task.attempt WriteCompleted

-}
write : Socket -> Bytes -> Task NetError {}
write socket bytes =
    Gren.Kernel.Net.write socket bytes


{-| Half-close the socket: send a FIN to the remote peer.

The socket stops sending data but can continue reading until the remote peer
closes its side as well; use this to signal "no more data from me" while
[`close`](#close) tears the socket down entirely.
-}
end : Socket -> Task NetError {}
end socket =
    Gren.Kernel.Net.end socket


{-| Close the socket immediately (destroy).

Queued writes are discarded and the socket is torn down (RST semantics for
unread data). Use [`end`](#end) for a graceful FIN half-close.
-}
close : Socket -> Task NetError {}
close socket =
    Gren.Kernel.Net.close socket
