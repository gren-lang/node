{
    "type": "package",
    "platform": "node",
    "name": "gren-lang/node",
    "summary": "Run Gren on Node.js",
    "license": "BSD-3-Clause",
    "version": "6.1.3",
    "exposed-modules": {
        "Core": [
            "Node",
            "Init",
            "Terminal",
            "ChildProcess"
        ],
        "File System": [
            "FileSystem",
            "FileSystem.FileHandle",
            "FileSystem.Path"
        ],
        "HTTP": [
            "HttpClient",
            "HttpServer",
            "HttpServer.Response",
            "WebSocketServer",
            "WebSocketServer.Connection"
        ],
        "SQLite": [
            "Sqlite",
            "Sqlite.Decode",
            "Sqlite.Encode",
            "Sqlite.Decode.Row",
            "Sqlite.Encode.Row",
            "Sqlite.Function",
            "Sqlite.Aggregate"
        ]
    },
    "gren-version": "0.6.0 <= v < 0.7.0",
    "dependencies": {
        "gren-lang/core": "7.0.0 <= v < 8.0.0",
        "gren-lang/url": "6.0.0 <= v < 7.0.0"
    }
}
