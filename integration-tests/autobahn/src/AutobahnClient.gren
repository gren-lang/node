module AutobahnClient exposing (main)

import Bytes exposing (Bytes)
import Init
import Maybe
import Node exposing (Environment, Program)
import Process
import Stream
import Stream.Log as Log
import String
import Task exposing (Task)
import WebSocketClient
import WebSocketClient.Connection as WsConn


main : Program Model Msg
main =
    Node.defineProgram
        { init = init
        , update = update
        , subscriptions = subscriptions
        }



-- Case-protocol driver for an Autobahn fuzzingserver on 127.0.0.1:9001.
--
-- The classic fuzzingserver drives everything from the upgrade path
-- (/getCaseCount, /runCase?case=N, /updateReports); this driver sends no
-- control messages at all — see fuzzing.py onOpen/onConnect in vendor/.
-- Flow: connect ?count=1 -> read the case count -> for each case k connect
-- ?id=k and echo all case traffic until the connection ends -> connect
-- ?report=1 (updateReports) -> exit 0.
--
-- Each connection carries a token (0 = count phase, 1..N = cases, -1 =
-- report phase). Events from a stale token are ignored, which tolerates the
-- race between a read failing with Stream.Closed and the onClose
-- subscription firing.


type alias Model =
    { env : Environment
    , permission : WebSocketClient.Permission
    , token : Int
    , state : State
    , connection : Maybe WebSocketClient.Connection
    , caseCount : Int
    }


type State
    = Connecting Int
    | ReadingCase Int
    | AwaitClose Int
    | Done


type Msg
    = ConnectDone { token : Int, result : Result WebSocketClient.ConnectError WebSocketClient.Connection }
    | ReadDone { token : Int, result : Result Stream.Error WebSocketClient.Message }
    | WriteDone { token : Int }
    | CloseObserved { token : Int }
    | CaseTimeout Int
    | DeferredExit Int


reportToken : Int
reportToken =
    -1


-- Hang guard per connection, not a case-length budget. The 12.x/13.x robots
-- cap every case at 480 s (closeAfter(WAITSECS) in case/case12_x_x.py), so
-- a case reaching 480 s is hung, not slow; the guard sits above that
-- ceiling (600000 ms) and must never fire in a healthy run (measured
-- per-case max: ~12 s). On expiry it logs and exits 1.
watchdogMs : Float
watchdogMs =
    600000


-- Margin between a diagnostic write and process exit. The fd-2 write only
-- completes on the Node write callback and process.exit does not wait for
-- it, so diagnostics chain through the sleep and exit via DeferredExit,
-- which no later message may cancel.
exitMarginMs : Float
exitMarginMs =
    250


init : Environment -> Init.Task { model : Model, command : Cmd Msg }
init env =
    Init.await WebSocketClient.initialize <|
        \permission ->
            Node.startProgram
                { model =
                    { env = env
                    , permission = permission
                    , token = 0
                    , state = Connecting 0
                    , connection = Nothing
                    , caseCount = -1
                    }
                , command =
                    Cmd.batch
                        [ connectWith 0 "getCaseCount?agent=gren-node" permission
                        , watchdog 0
                        ]
                }


update : Msg -> Model -> { model : Model, command : Cmd Msg }
update msg model =
    when msg is
        ConnectDone { token, result } ->
            if token /= model.token then
                { model = model, command = Cmd.none }

            else
                when result is
                    Ok connection ->
                        { model =
                            { model
                                | state = ReadingCase token
                                , connection = Just connection
                            }
                        , command = readFrom token connection
                        }

                    Err (WebSocketClient.ConnectError { code, message }) ->
                        -- Some client-side cases (6.x) deliberately abort
                        -- the handshake; a failed connect for a case token
                        -- counts as that case having ended.
                        if token > 0 then
                            advance token model

                        else
                            logFatal model
                                ("connect failed (token "
                                    ++ String.fromInt token
                                    ++ "): "
                                    ++ code
                                    ++ " "
                                    ++ message
                                )

        ReadDone { token, result } ->
            if token /= model.token then
                { model = model, command = Cmd.none }

            else
                when result is
                    Ok message ->
                        onMessage token message model

                    Err _ ->
                        -- Stream.Closed / Cancelled: the connection ended;
                        -- advance regardless of which came first.
                        advance token model

        WriteDone _ ->
            -- Write failures always surface later as a closed connection;
            -- never fail on them here.
            { model = model, command = Cmd.none }

        CloseObserved { token } ->
            if token /= model.token then
                { model = model, command = Cmd.none }

            else
                advance token model

        CaseTimeout tok ->
            if tok == model.token then
                caseValue model.state
                    |> Maybe.map
                        (\t ->
                            { model = model
                            , command =
                                diagnosticThenExit model 1 ("TIMEOUT in phase token " ++ String.fromInt t)
                            }
                        )
                    |> Maybe.withDefault { model = model, command = Cmd.none }

            else
                { model = model, command = Cmd.none }

        DeferredExit code ->
            -- Token-free and unconditional: diagnosticThenExit already
            -- flushed the diagnostic; nothing may cancel this exit.
            { model = model, command = Node.exitWithCode code }


onMessage : Int -> WebSocketClient.Message -> Model -> { model : Model, command : Cmd Msg }
onMessage tok message model =
    caseValue model.state
        |> Maybe.map
            (\t ->
                if t /= tok then
                    { model = model, command = Cmd.none }

                else if t == 0 then
                    onCaseCount message model

                else if t < 0 then
                    -- updateReports answers with informational JSON; the
                    -- only thing that matters is the following close.
                    { model = model, command = Cmd.none }

                else
                    -- Echo case traffic byte-for-byte and keep waiting for
                    -- the connection to end.
                    when model.connection is
                        Just connection ->
                            { model = { model | state = AwaitClose t }
                            , command =
                                Cmd.batch
                                    [ Stream.write message (WsConn.writable connection)
                                        |> Task.attempt (\_ -> WriteDone { token = t })
                                    , readFrom t connection
                                    ]
                            }

                        Nothing ->
                            { model = model, command = Cmd.none }
            )
        |> Maybe.withDefault { model = model, command = Cmd.none }


onCaseCount : WebSocketClient.Message -> Model -> { model : Model, command : Cmd Msg }
onCaseCount message model =
    when message is
        WebSocketClient.TextMessage text ->
            -- The classic fuzzingserver replies to getCaseCount with a bare
            -- integer as text (fuzzing.py: sendText(str(num_cases))).
            when String.toInt (String.trim text) is
                Just count ->
                    { model =
                        { model
                            | caseCount = count
                            , token = 1
                            , state = Connecting 1
                            , connection = Nothing
                        }
                    , command =
                        Cmd.batch
                            [ Log.line model.env.stdout ("CASES=" ++ String.fromInt count)
                                |> Task.execute
                            , connectWith 1 "runCase?case=1&agent=gren-node" model.permission
                            , watchdog 1
                            ]
                    }

                Nothing ->
                    logFatal model ("bad getCaseCount response: " ++ text)

        WebSocketClient.BinaryMessage _ ->
            logFatal model "unexpected binary message in count phase"


advance : Int -> Model -> { model : Model, command : Cmd Msg }
advance tok model =
    caseValue model.state
        |> Maybe.map
            (\t ->
                if t /= tok then
                    { model = model, command = Cmd.none }

                else if t == 0 then
                    logFatal model "count phase ended before getCaseCount responded"

                else if t < 0 then
                    -- The report connection closed: everything is done.
                    { model = { model | state = Done, connection = Nothing }
                    , command = Node.exitWithCode 0
                    }

                else if t >= model.caseCount then
                    { model =
                        { model
                            | token = reportToken
                            , state = Connecting reportToken
                            , connection = Nothing
                        }
                    , command =
                        Cmd.batch
                            [ connectWith reportToken "updateReports?agent=gren-node" model.permission
                            , watchdog reportToken
                            ]
                    }

                else
                    startCase (t + 1) { model | connection = Nothing }
            )
        |> Maybe.withDefault { model = model, command = Cmd.none }


startCase : Int -> Model -> { model : Model, command : Cmd Msg }
startCase k model =
    { model =
        { model
            | token = k
            , state = Connecting k
            , connection = Nothing
        }
    , command =
        Cmd.batch
            [ connectWith k ("runCase?case=" ++ String.fromInt k ++ "&agent=gren-node") model.permission
            , watchdog k
            ]
    }


logFatal : Model -> String -> { model : Model, command : Cmd Msg }
logFatal model text =
    { model = model
    , command = diagnosticThenExit model 1 text
    }


diagnosticThenExit : Model -> Int -> String -> Cmd Msg
diagnosticThenExit model code text =
    Log.line model.env.stderr text
        |> Task.andThen (\_ -> Process.sleep exitMarginMs)
        |> Task.attempt (\_ -> DeferredExit code)


subscriptions : Model -> Sub Msg
subscriptions model =
    when model.connection is
        Just connection ->
            WebSocketClient.onClose connection (\_ -> CloseObserved { token = model.token })

        Nothing ->
            Sub.none


connectWith : Int -> String -> WebSocketClient.Permission -> Cmd Msg
connectWith tok suffix permission =
    WebSocketClient.connect permission
        { url = "ws://127.0.0.1:9001/" ++ suffix, options = [] }
        |> Task.attempt (\result -> ConnectDone { token = tok, result = result })


watchdog : Int -> Cmd Msg
watchdog tok =
    Process.sleep watchdogMs
        |> Task.attempt (\_ -> CaseTimeout tok)


readFrom : Int -> WebSocketClient.Connection -> Cmd Msg
readFrom tok connection =
    WsConn.readable connection
        |> Stream.read
        |> Task.attempt (\result -> ReadDone { token = tok, result = result })


caseValue : State -> Maybe Int
caseValue state =
    when state is
        Connecting t ->
            Just t

        ReadingCase t ->
            Just t

        AwaitClose t ->
            Just t

        Done ->
            Nothing
